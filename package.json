{
  "name": "zod-mermaid",
  "version": "1.3.0",
  "description": "Generate Mermaid diagrams from Zod schemas",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "regenerate:readme": "tsx scripts/regenerate-readme.ts",
    "regenerate:examples": "tsx scripts/regenerate-examples.ts",
    "regenerate:multiple-schemas": "tsx scripts/regenerate-multiple-schemas.ts",
    "regenerate:all": "npm run regenerate:readme && npm run regenerate:examples && npm run regenerate:multiple-schemas"
  },
  "keywords": [
    "typescript",
    "zod",
    "mermaid",
    "schema",
    "visualization"
  ],
  "author": "Michael Houston (https://kothar.net)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kothar/zod-mermaid.git"
  },
  "bugs": {
    "url": "https://github.com/kothar/zod-mermaid/issues"
  },
  "homepage": "https://github.com/kothar/zod-mermaid#readme",
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mermaid": "^11.17.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
